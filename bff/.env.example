# BFF environment.
# The Foundry token lives ONLY here — never sent to the browser.
# Copy to .env and fill in.

BFF_PORT=8787
ALLOWED_ORIGIN=http://localhost:5173

# Foundry connection (used in Phase 1+, ignored in Phase 0 mock mode)
FOUNDRY_STACK_URL=https://victus.usw-23.palantirfoundry.com
FOUNDRY_ONTOLOGY=ontology-abe5026d-72be-438c-980f-344a88cff4dc
FOUNDRY_TOKEN=

# Phase 0: when MOCK_MODE=true, BFF returns hardcoded data instead of hitting Foundry.
# Flip to false in Phase 1 once FOUNDRY_TOKEN is set.
MOCK_MODE=true
