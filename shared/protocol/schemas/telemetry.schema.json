{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://victus.natsec/protocol/0.2.0/telemetry.schema.json",
  "title": "VICTUS telemetry payload",
  "type": "object",
  "required": ["event"],
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "Position",
        "Status",
        "Detection",
        "ReasoningTrace",
        "FrameThumbnail",
        "CommandAck",
        "MissionEvent"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "event": { "const": "Position" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "alt_m": { "type": "number" },
        "heading_deg": { "type": "number" },
        "speed_mps": { "type": "number" },
        "battery_pct": { "type": "number" }
      },
      "required": ["event", "lat", "lon", "alt_m"]
    },
    {
      "properties": {
        "event": { "const": "Status" },
        "state": {
          "type": "string",
          "enum": ["NOMINAL", "DEGRADED", "BINGO", "WINCHESTER", "LINK_LOST"]
        },
        "flags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["event", "state"]
    },
    {
      "properties": {
        "event": { "const": "Detection" },
        "detection_id": { "type": "string" },
        "class": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "geo": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lon": { "type": "number" }
          }
        },
        "frame_ref": { "type": "string" }
      },
      "required": ["event", "detection_id", "class", "confidence", "bbox"]
    },
    {
      "properties": {
        "event": { "const": "ReasoningTrace" },
        "command_id": { "type": "string" },
        "decision": { "type": "string" },
        "rationale": { "type": "string", "maxLength": 500 },
        "tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["event", "command_id", "decision", "rationale"]
    },
    {
      "properties": {
        "event": { "const": "FrameThumbnail" },
        "format": { "type": "string", "enum": ["jpeg"] },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "b64": { "type": "string" }
      },
      "required": ["event", "format", "width", "height", "b64"]
    },
    {
      "properties": {
        "event": { "const": "CommandAck" },
        "command_id": { "type": "string" },
        "result": {
          "type": "string",
          "enum": ["ACCEPTED", "REJECTED", "EXPIRED"]
        },
        "reason": { "type": "string" }
      },
      "required": ["event", "command_id", "result"]
    },
    {
      "properties": {
        "event": { "const": "MissionEvent" },
        "command_id": { "type": "string" },
        "event_kind": {
          "type": "string",
          "enum": ["STARTED", "COMPLETED", "ABORTED", "FALLBACK_HOLD"]
        }
      },
      "required": ["event", "event_kind"]
    }
  ]
}
