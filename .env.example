# VICTUS edge environment.
# Copy to .env and fill in. Both edge and CI read from real env, not this file.

# --- Identity ---------------------------------------------------------------
VICTUS_DRONE_ID=uav-01

# --- Foundry endpoints ------------------------------------------------------
# Stack URL (no trailing slash). For the local stub use http://192.168.55.100:8080
# (the Mac's IP on the USB-C network); for real Foundry use https://<your-stack>.palantirfoundry.com
FOUNDRY_STACK_URL=https://victus.usw-23.palantirfoundry.com

# Streaming dataset RID for raw_telemetry (the dataset the edge publishes records to).
# For the stub, any value works (the stub accepts any datasetRid in the path).
FOUNDRY_TELEMETRY_DATASET_RID=ri.foundry.main.dataset.<uuid>

# Streams V2 viewRid — recommended for real Foundry, ignored by the stub.
# Look it up after creating the streaming dataset (see WORKSHOP_RUNBOOK.md).
FOUNDRY_TELEMETRY_VIEW_RID=

# Ontology to query for commands. Either:
#   - the API name (e.g. ontology-abe5026d-72be-438c-980f-344a88cff4dc), OR
#   - the RID (e.g. ri.ontology.main.ontology.10d8565f-992c-4cd2-8df5-0328b5d7e46b)
FOUNDRY_ONTOLOGY=ontology-abe5026d-72be-438c-980f-344a88cff4dc

# API name of the command object type. Foundry auto-namespaces created object
# types with a per-org prefix; for our project the type is "pzqmccug.command".
FOUNDRY_COMMAND_OBJECT_TYPE=pzqmccug.command

# --- Auth -------------------------------------------------------------------
# STATIC: personal API token in env (Phase 1.0 default).
# OAUTH:  client_credentials grant (Phase 1.1).
FOUNDRY_AUTH_MODE=STATIC

# Required when FOUNDRY_AUTH_MODE=STATIC. For real Foundry, must hold scopes
# api:streams-write (for telemetry) and api:ontologies-read (for commands).
FOUNDRY_TOKEN=

# Required when FOUNDRY_AUTH_MODE=OAUTH (unused in STATIC mode)
FOUNDRY_OAUTH_TOKEN_URL=https://victus.usw-23.palantirfoundry.com/multipass/api/oauth2/token
FOUNDRY_CLIENT_ID=
FOUNDRY_CLIENT_SECRET=

# --- Loop tuning ------------------------------------------------------------
COMMAND_POLL_INTERVAL_S=2.0
POSITION_EMIT_INTERVAL_S=5.0

# --- Backends (Phase 2; default to mock for Phase 1) -----------------------
VICTUS_LLM_BACKEND=mock
VICTUS_LLM_MODEL_PATH=
VICTUS_VISION_SOURCE=mock
VICTUS_AUTONOMY_BACKEND=mock

# --- Local state ------------------------------------------------------------
VICTUS_TELEMETRY_BUFFER_PATH=./runtime/buffer.jsonl
VICTUS_LOG_LEVEL=INFO
