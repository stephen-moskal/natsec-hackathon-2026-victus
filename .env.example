# VICTUS edge environment.
# Copy to .env and fill in. Both edge and CI read from real env, not this file.

# --- Identity ---------------------------------------------------------------
VICTUS_DRONE_ID=uav-01

# --- Foundry endpoints ------------------------------------------------------
# Listener URL is the unique HTTPS URL generated when you create the
# `telemetry-inbound` webhook on the `victus-edge-ingest` REST API data source.
FOUNDRY_LISTENER_URL=https://<your-stack>.palantirfoundry.com/listener/<unique-id>
# Functions base URL points at the API gateway for query functions.
# Edge constructs `${FOUNDRY_FUNCTIONS_URL}/pollCommands/execute`.
FOUNDRY_FUNCTIONS_URL=https://<your-stack>.palantirfoundry.com/api/v2/ontologies/<ontology-rid>/queries

# --- Auth -------------------------------------------------------------------
# STATIC: personal API token in env (Phase 1.0 default).
# OAUTH:  client_credentials grant (Phase 1.1).
FOUNDRY_AUTH_MODE=STATIC

# Required when FOUNDRY_AUTH_MODE=STATIC
FOUNDRY_TOKEN=

# Required when FOUNDRY_AUTH_MODE=OAUTH (unused in STATIC mode)
FOUNDRY_OAUTH_TOKEN_URL=https://<your-stack>.palantirfoundry.com/multipass/api/oauth2/token
FOUNDRY_CLIENT_ID=
FOUNDRY_CLIENT_SECRET=

# --- Loop tuning ------------------------------------------------------------
COMMAND_POLL_INTERVAL_S=2.0
POSITION_EMIT_INTERVAL_S=5.0

# --- Backends (Phase 2; default to mock for Phase 1) -----------------------
VICTUS_LLM_BACKEND=mock
VICTUS_LLM_MODEL_PATH=
VICTUS_VISION_SOURCE=mock
VICTUS_AUTONOMY_BACKEND=mock

# --- Local state ------------------------------------------------------------
VICTUS_TELEMETRY_BUFFER_PATH=./runtime/buffer.jsonl
VICTUS_LOG_LEVEL=INFO
